# Copy to .env and fill in the empty values. Never commit .env.

# Required
MONGO_URI=mongodb://localhost:27017/pulseforge
# At least 32 random characters
JWT_SECRET=
POSTGRES_PASSWORD=

# Optional (defaults shown)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DB=pulseforge
PORT=3000
FRONTEND_URL=http://localhost:5173
TRUST_PROXY_HOPS=0
# NODE_ENV=production
# PGSSLMODE=verify-full
